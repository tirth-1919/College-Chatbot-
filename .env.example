# ==============================================================================
# AIT AI ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Institution: Ahmedabad Institute of Technology (https://www.aitindia.in)
# ==============================================================================

# Core Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=AIT AI ASSISTANT
APP_VERSION=1.0.0

# Security & Secrets
# Generate a secure 64-char key in production: openssl rand -hex 32
SECRET_KEY=ait-ai-assistant-enterprise-secret-key-replace-in-production-2026

# Database Architecture
# Development: SQLite (zero configuration out of the box)
DATABASE_URL=sqlite:///./backend/ait_assistant.db
# Production: PostgreSQL with pgvector
# DATABASE_URL=postgresql+psycopg2://ait_user:ait_secure_password@localhost:5432/ait_assistant

# Redis Cache & State (graceful in-memory fallback if disabled or unreachable)
USE_REDIS=false
REDIS_URL=redis://localhost:6379/0

# AI Provider Credentials (Graceful fallback to verified AIT database/RAG if keys absent)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Google OAuth Credentials (Graceful UI configuration notification if empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Storage Limits
MAX_FILE_SIZE_BYTES=26214400
UPLOAD_DIR=./backend/storage/uploads
IMAGE_STORAGE_DIR=./backend/storage/images
