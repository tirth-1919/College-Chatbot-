# Root Environment Variables Template for AI FAQ College Chat Bot
# Copy this file to .env and configure with your credentials.

# ==============================================================================
# DATABASE & SUPABASE POSTGRESQL (pgvector)
# ==============================================================================
# Connect to your Supabase project (replace with your password and project ref)
DATABASE_URL="postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
SUPABASE_STORAGE_BUCKET_DOCS="college-documents"

# ==============================================================================
# ARTIFICIAL INTELLIGENCE PROVIDERS
# ==============================================================================
# Primary: Google Gemini API (Get free key at https://aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_DEFAULT_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSION=768

# Secondary Fallback: OpenAI / Groq / Anthropic (Optional)
SECONDARY_AI_ENABLED=False
SECONDARY_AI_PROVIDER="openai"
SECONDARY_AI_API_KEY=""
SECONDARY_AI_MODEL="gpt-4o-mini"

# ==============================================================================
# AUTHENTICATION & SECURITY
# ==============================================================================
JWT_SECRET_KEY="generate-a-secure-random-secret-key-at-least-32-characters"
JWT_ALGORITHM="HS256"
# Generate one independent 32-byte hex value and provision the same value in the
# owner-only auth_private.rls_context_keys table after migration 021.
RLS_CONTEXT_SECRET="generate-64-hex-characters-with-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_FRONTEND_URL="http://localhost:3001"  # Production requires HTTPS and a non-localhost host.

# Optional SMTP delivery; SMTP acceptance is not a guarantee of inbox delivery.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_STARTTLS=True
SMTP_TIMEOUT_SECONDS=10
EMAIL_DELIVERY_TIMEOUT_SECONDS=15

# ==============================================================================
# ASYNC WORKERS (REDIS & CELERY)
# ==============================================================================
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# ==============================================================================
# OPENAI PROVIDER (new — for multi-provider failover)
# ==============================================================================
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL_PRIORITY=gpt-4o-mini,gpt-4o,gpt-3.5-turbo

# ==============================================================================
# XKIRO PROVIDER (new — tertiary failover)
# NOTE: Model names xkiro-chat and xkiro-fast are placeholders.
#       Verify actual model identifiers against the xKiro API documentation.
# ==============================================================================
XKIRO_API_KEY=your-xkiro-api-key-here
XKIRO_API_BASE_URL=https://api.xkiro.com/v1
XKIRO_MODEL_PRIORITY=xkiro-chat,xkiro-fast

# ==============================================================================
# GEMINI MULTI-MODEL PRIORITY (new)
# ==============================================================================
GEMINI_MODEL_PRIORITY=gemini-1.5-flash,gemini-1.5-pro,gemini-2.0-flash-exp

# ==============================================================================
# AI PROVIDER FAILOVER SETTINGS (new)
# ==============================================================================
AI_MAX_RETRIES=3
AI_TIMEOUT_SECONDS=30
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_COOLDOWN_SECONDS=60
AI_GENERAL_ANSWERING_ENABLED=true
