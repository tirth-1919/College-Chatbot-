# Environment Configuration Template for AI FAQ College Chat Bot
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!

# ==============================================================================
# 1. APPLICATION SETTINGS
# ==============================================================================
PROJECT_NAME="AI FAQ College Chat Bot"
ENVIRONMENT="development"  # development | staging | production
DEBUG=True
API_V1_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
ADMIN_FRONTEND_URL="http://localhost:3001"  # Production requires the public HTTPS admin frontend URL.

# ==============================================================================
# 2. SUPABASE POSTGRESQL & STORAGE
# ==============================================================================
# Replace with your Supabase Transaction Pooler or Direct Connection String
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET_DOCS="college-documents"

# ==============================================================================
# 3. AUTHENTICATION & SECURITY
# ==============================================================================
# Generate a secure 32+ character secret: openssl rand -hex 32
JWT_SECRET_KEY="replace-this-with-a-very-secure-random-secret-key-32-chars-min"
JWT_ALGORITHM="HS256"
# Independent key used to authenticate RLS context; provision the same value in
# auth_private.rls_context_keys using a trusted database-owner connection.
RLS_CONTEXT_SECRET="generate-64-hex-characters-with-openssl-rand-hex-32"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================================================
# 3A. EMAIL DELIVERY
# ==============================================================================
# SMTP acceptance is recorded as SENT; it does not guarantee inbox delivery.
# Leave SMTP_HOST and SMTP_FROM_EMAIL unset to disable delivery (notifications
# will be recorded as FAILED, never as SENT or SIMULATED).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL=""
SMTP_STARTTLS=True
SMTP_TIMEOUT_SECONDS=10
EMAIL_DELIVERY_TIMEOUT_SECONDS=15

# ==============================================================================
# 4. REDIS & CELERY WORKERS
# ==============================================================================
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# ==============================================================================
# 5. AI PROVIDER CONFIGURATION
# ==============================================================================
# Primary AI: Google Gemini API (Get free key from https://aistudio.google.com)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_DEFAULT_MODEL="gemini-1.5-flash"
GEMINI_EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSION=768

# Secondary Fallback AI (e.g., OpenAI, Groq, or Anthropic)
SECONDARY_AI_ENABLED=False
SECONDARY_AI_PROVIDER="openai"  # openai | groq | anthropic
SECONDARY_AI_API_KEY=""
SECONDARY_AI_MODEL="gpt-4o-mini"

# ==============================================================================
# 6. OCR & DOCUMENT EXTRACTION CONFIGURATION
# ==============================================================================
# Path to Tesseract binary (Optional if already in PATH)
# Windows default: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux default: /usr/bin/tesseract
TESSERACT_CMD=""
TESSERACT_DEFAULT_LANG="eng"  # English default, extensible to "eng+hin+guj"
MAX_DOCUMENT_SIZE_MB=50
MAX_DOCUMENT_PAGES=200

# ==============================================================================
# 7. TELEMETRY, MONITORING & SENTRY
# ==============================================================================
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT="production"

