FROM node:20-alpine AS builder

WORKDIR /app
COPY apps/admin-web/package*.json ./
RUN npm ci

COPY apps/admin-web/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY infrastructure/nginx/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
